# Copy this file to .env and fill in real values for local development.
# Never commit the real .env file (already covered by .gitignore).

# --- Database ---
DATABASE_URL=postgresql+asyncpg://facial_analysis:facial_analysis@localhost:5433/facial_analysis

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000

# Optional: enable TrustedHostMiddleware in production (comma-separated hostnames, no scheme).
# Example: TRUSTED_HOSTS=api.example.com,localhost
# Leave empty when FastAPI is only reached via an internal Next.js rewrite.
# TRUSTED_HOSTS=

# --- Auth / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-dev-only-not-a-real-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OTP ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
OTP_PEPPER=change-me-dev-only-not-a-real-secret
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=15

# --- Email delivery ---
# "console" logs OTP emails to stdout instead of sending real email (dev default).
# "smtp" sends real email -- requires SMTP_HOST/USERNAME/PASSWORD/EMAIL_FROM below.
EMAIL_PROVIDER=console
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=            # Gmail: a 16-char App Password, NOT your account password -- https://myaccount.google.com/apppasswords
# EMAIL_FROM=you@gmail.com

# --- Photo storage ---
# "database" (default -- bytes live in Postgres, nothing written to disk),
# "local" (writes to Backend/var/photo_storage/), or "s3" -- S3 requires
# S3_BUCKET/S3_REGION/S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY below.
PHOTO_STORAGE_PROVIDER=database
# PHOTO_STORAGE_LOCAL_DIR=var/photo_storage
# PHOTO_MAX_UPLOAD_BYTES=15728640
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=            # only for non-AWS S3-compatible providers (R2, MinIO, Spaces)

# --- AI narrative generation (facial-analysis-engine) ---
# OpenAI, per NFR-008 (client_requirements.md) -- ran on DeepSeek's
# OpenAI-compatible API for a while instead (ASM-006, a delivery-team
# substitution), switched back 2026-09-16 once a billed OpenAI key was
# available. Get a key at https://platform.openai.com/api-keys -- required
# to trigger analysis at all; left unset here since most local dev/testing
# never exercises this module. To use DeepSeek instead, set AI_PROVIDER=
# deepseek, AI_BASE_URL=https://api.deepseek.com, and AI_MODEL=deepseek-v4-
# flash-vision-exp (or whichever DeepSeek model is current) -- OPENAI_API_KEY
# would then need to hold the DeepSeek key instead.
AI_PROVIDER=openai
# OPENAI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o
AI_REQUEST_TIMEOUT_SECONDS=900

# --- AI image generation (before/after previews, Milestone 2 FR-022) ---
# OpenAI gpt-image-1 (images.edit), switched from Gemini 2.5 Flash Image
# 2026-09-16 (Gemini's free tier had zero image-gen quota). Shares
# OPENAI_API_KEY above -- there is no separate image-gen key anymore, since
# both narrative and image generation are the same OpenAI account. To use
# Gemini instead, set IMAGE_GEN_PROVIDER=gemini, IMAGE_GEN_MODEL=gemini-2.5-
# flash-image, and OPENAI_API_KEY to a real Gemini key (an intentional edge
# case this project doesn't currently use).
IMAGE_GEN_PROVIDER=openai
IMAGE_GEN_MODEL=gpt-image-1
IMAGE_GEN_REQUEST_TIMEOUT_SECONDS=60
IMAGE_GEN_MAX_RETRIES=2
IMAGE_GEN_MAX_CONCURRENCY=3

# --- Crash-recovery reconciler (Milestone 3.1, Phase 21) ---
RECONCILER_STUCK_THRESHOLD_MINUTES=20
RECONCILER_SWEEP_INTERVAL_SECONDS=300
RECONCILER_MAX_RESUMED_PER_SWEEP=5

# --- Error tracking (Milestone 3.1, Phase 23) ---
# Sentry. Left unset here -- the integration is fully inert without a real
# DSN (app/core/error_tracking.py), so this is safe to leave blank until an
# account is actually provisioned.
# SENTRY_DSN=

# --- Payment (FR-015, FR-016, BR-001) ---
# Test-mode keys from https://dashboard.stripe.com/test/apikeys -- required
# to trigger a real checkout; left unset here since most local dev/testing
# never exercises this module (the Stripe client is monkeypatched in tests).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=          # from `stripe listen` or the Stripe dashboard's webhook config
# OQ-002 (report price) is explicitly kept open by the client -- this is a
# clearly-flagged placeholder, not a real number.
REPORT_PRICE_CENTS=1999
REPORT_PRICE_CURRENCY=usd
# Used to build Stripe Checkout's success_url/cancel_url redirects.
FRONTEND_BASE_URL=http://localhost:3000

# --- App ---
ENVIRONMENT=development
# production enables: Secure cookies, HSTS, TrustedHost, disables /docs
