# Browser-facing API base (same-origin proxy — see next.config.ts rewrites).
# Do NOT point this at http://localhost:8000; cross-origin cookies break session restore.
NEXT_PUBLIC_API_URL=/api/backend

# Server-only: where Next.js rewrites /api/backend/* (not exposed to the browser).
BACKEND_URL=http://localhost:8000

# Production: serve Next.js over HTTPS, keep NEXT_PUBLIC_API_URL=/api/backend,
# set BACKEND_URL to the internal FastAPI URL. See docs/security.md §8.

# Public site origin, used only by robots.ts/sitemap.ts (Milestone 3.1,
# Phase 24) to build absolute URLs. Defaults to localhost:3000 if unset.
# NEXT_PUBLIC_SITE_URL=https://your-production-domain.example
